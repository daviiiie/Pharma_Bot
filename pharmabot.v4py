# ------------------ CONFIG ------------------ #
NTFY_URL = "https://ntfy.sh/SISTEMA_PHARMABOT"   # tópico público: evite dados sensíveis nas mensagens
NTFY_TIMEOUT = 5                                  # segundos; ntfy nunca pode travar o bot
LIMITE_MSG = 3500                                 # ntfy aceita ~4096 bytes por mensagem

ULTIMAS_ETAPAS = deque(maxlen=12)   # memória curta: o que o bot fez antes de travar
ESTADO = {}                         # dados do item atual (vai junto na log de erro)
NTFY_LOG_LOCK = False               # evita recursão entre log() e enviar_ntfy()


# INICIO DO SISTEMA #

def log(etapa, origem="SISTEMA"):
    """print com horário + categoria + guarda nas últimas etapas + envia para ntfy em baixa prioridade."""
    origem = str(origem).upper()
    linha = f"[{datetime.now().strftime('%H:%M:%S')}] {origem}: {etapa}"
    print(linha)
    ULTIMAS_ETAPAS.append(linha)

    global NTFY_LOG_LOCK
    if NTFY_LOG_LOCK:
        return

    tags_map = {
        "SISTEMA": "speech_balloon",
        "INICIO": "rocket",
        "LISTA": "clipboard",
        "ITEM": "package",
        "VALOR": "moneybag",
        "CONFIRMACAO": "white_check_mark",
        "ERRO": "rotating_light",
        "FIM": "tada",
        "PHARMACONNECT": "computer",
        "NTFY": "mailbox_with_mail",
    }

    NTFY_LOG_LOCK = True
    try:
        enviar_ntfy(
            f"PharmaBot - {origem}",
            linha,
            prioridade="low",
            tags=tags_map.get(origem, "speech_balloon"),
        )
    except Exception:
        pass
    finally:
        NTFY_LOG_LOCK = False


def notificacao(titulo, mensagem, duracao):
    toast = Notification(app_id="PharmaBot", title=titulo, msg=mensagem, duration=duracao)
    toast.show()


def enviar_ntfy(titulo, mensagem, prioridade="default", tags=""):
    """POST de texto pro ntfy. Qualquer falha aqui é só registrada, nunca derruba o bot."""
    try:
        resp = requests.post(
            NTFY_URL,
            data=mensagem[:LIMITE_MSG].encode("utf-8"),
            headers={"Title": titulo, "Priority": prioridade, "Tags": tags},
            timeout=NTFY_TIMEOUT,
        )
        resp.raise_for_status()
        return True
    except Exception:
        return False


def enviar_ntfy_anexo(caminho, titulo="PharmaBot - print do erro"):
    """Manda o print como anexo (mensagem separada, pois o corpo vira o arquivo)."""
    try:
        with open(caminho, "rb") as f:
            resp = requests.post(
                NTFY_URL,
                data=f,
                headers={"Title": titulo, "Filename": os.path.basename(caminho)},
                timeout=NTFY_TIMEOUT * 3,
            )
        resp.raise_for_status()
        log("print anexado no ntfy", "NTFY")
    except Exception as e:
        log(f"falha ao enviar anexo ntfy: {e}", "NTFY")


def registrar_erro(aba, contexto, erro=None):
    """Salva print + log em ./erros/ (backup) e envia resumo + print pro ntfy."""
    os.makedirs("erros", exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    caminho_png = f"erros/{stamp}.png"
    tb = traceback.format_exc()

    # 1) print da tela
    try:
        aba.screenshot(path=caminho_png, full_page=True)
    except Exception:
        caminho_png = None

    # 2) texto da log (traceback por último, pra cortar o que menos importa)
    texto = "\n".join([
        f"Contexto: {contexto}",
        f"Erro: {type(erro).__name__}: {erro}" if erro else "Erro: (sem exceção)",
        f"Estado: {ESTADO}",
        "",
        "Últimas etapas:",
        *ULTIMAS_ETAPAS,
        "",
        "Traceback:",
        tb,
    ])

    # 3) backup local
    with open(f"erros/{stamp}.log", "w", encoding="utf-8") as f:
        f.write(texto)
    print(tb)

    # 4) ntfy
    enviar_ntfy("PharmaBot - ERRO", texto, prioridade="high", tags="rotating_light")
    if caminho_png:
        enviar_ntfy_anexo(caminho_png)


def abrir_navegador(p):

    log("abrindo navegador...", "INICIO")
    navegador = p.chromium.launch(headless= False, channel="chrome")
    aba = navegador.new_page()
    aba.goto("https://dpsp.pharmaconnection.com.br/conferencia/saldo") 
    log("página de conferência carregada", "INICIO")

    janela.showinfo("Instrução", "Por favor, faça login no Pharmaconnect e gere a lista desejada. Depois pressione OK.") #user_instrução 1 

    permissao_sistema = janela.askyesnocancel("AVISO", "Começar PharmaBot?")

    if permissao_sistema is True:

        try:
            janela.showinfo("Instrução", "Lembre-se que a lista deve filtrar apenas os remédios pendentes!") #user_instrução 2
            log("aguardando a lista (até 60s)...", "LISTA")
            aba.wait_for_selector("#dt_table_info", timeout= 60000) #aguarda 1 minuto 
            extracao = aba.locator("#dt_table_info").inner_text()
            log(f"texto do contador: '{extracao}'", "LISTA")
            total_remedios = int(re.search(r"de (\d+) registros", extracao).group(1))

            notificacao("PharmaBot", f"Total de remédios: {total_remedios}", "short")
            log(f"total de remédios: {total_remedios}", "LISTA")

            return aba, total_remedios #retorna os valores encontrados para a a função de conferência.

        except Exception as e:
            registrar_erro(aba, "Falha ao localizar a lista / total de remédios", e)
            janela.showerror("Erro", "Não foi possível executar o bot. Verifique se você está logado no PharmaConnect")
            return None
        
    elif permissao_sistema is False:
        log("usuário cancelou a execução do bot.")
        notificacao("PharmaBot", "Execução cancelada pelo usuário.", "short")
        return None

    elif permissao_sistema is None:
        log("usuário fechou a janela de permissão.")
        return None
#----------------------------------------------------------------


def conferir_remedios(aba, total_remedios):
    notificacao("PharmaBot", "Iniciando conferência...", "short")
    log(f"iniciando conferência de {total_remedios} itens", "INICIO")

    modal = aba.locator("#modal-check") # menu de conferência.
    campo_sistema = aba.locator("#item-check input[name='amount']")
    campo_armario = aba.locator("#item-check input[name='amount_check']")
    seta = aba.locator("#btn-check-amt-match") #atalho para conferência 

    inicio = time.perf_counter()
    conferidos = 0
    concluiu = True

    while conferidos < total_remedios:
        item = conferidos + 1
        t_item = time.perf_counter()
        ESTADO.clear()
        ESTADO.update({"item": f"{item}/{total_remedios}"})
        log(f"--- item {item}/{total_remedios} ---", "ITEM")

        try:
            # 1) usa a ordem real da tabela: o item atual é sempre a primeira linha visível
            linha = aba.locator("table#dt_table tbody tr").first
            texto_linha = linha.inner_text()

            # 2) tenta extrair o CI apenas para log/debug; não usa para localizar a linha
            #por enquanto o CI tá sendo usado apenas para log, mas vou usar pra localizar a linha correta.
            #TODO programar segunda linha para localização.
            
            ci_match = re.search(r"(?i)ci:\s*(\d+)", texto_linha)
            ci = ci_match.group(1) if ci_match else None
            if ci:
                log(f"CI atual detectado: {ci}", "VALOR")
            else:
                log(f"CI não encontrado na linha atual: {texto_linha[:250]}", "VALOR")

            # 3) clica no botão da linha atual (o botão vermelho do item pendente)
            botao = linha.locator("a.btn-danger, button.btn-danger")
            if botao.count() == 0:
                raise RuntimeError(f"Botão do item não encontrado na primeira linha da tabela. Texto: {texto_linha[:400]}")

            botao.first.click(timeout=15000)
            
            #segunda_linha = aba.locator("table#dt_table tbody tr").nth(1) # segunda linha
            #se for necessário posteriormente, fica aqui.
            
            #-------------------------------------------------------#

            log("botão vermelho clicado, aguardando modal...", "ITEM")
            expect(modal).to_be_visible(timeout=10000) #espera o menu de conferência estar visivel em até 10s

            # 5) espera os campos carregarem (valor não vazio) e lê ANTES de clicar na seta
            #TODO: preciso revisar e entender o por quê das divergências lançadas pelo bot.

            expect(campo_sistema).not_to_have_value("", timeout=10000) #OK
            expect(campo_armario).not_to_have_value("", timeout=10000) #OK
            
            sistema = int(campo_sistema.input_value()) #OK
            armario = int(campo_armario.input_value()) # OK
            
            ESTADO.update({"sistema": sistema, "armario_inicial": armario}) #OK
            log(f"Sistema: {sistema} | Armário: {armario}", "VALOR") #OK

            # 6) só clica na seta se estiver diferente    #analisando...
            if armario != sistema:   
                log("valores diferentes: esperando seta habilitar...", "VALOR")
                expect(seta).to_be_enabled(timeout=10000)
                seta.click()
                log("seta clicada, esperando o Armário atualizar...", "VALOR")

                expect(campo_armario).to_have_value(str(sistema), timeout=10000) 
                log("Armário atualizou", "VALOR")
            else: #se os dados não estiverem divergentes, o bot segue sem confirmação manual.
                # --- MANUTENÇÃO DESATIVADA ---
                # resposta = messagebox.askyesno(
                #     "PharmaBot",
                #     f"Item {item}: os valores realmente batem? \n(Sistema={sistema}, Armário={armario})",
                #     icon="warning",
                # )
                # enviar_ntfy("PharmaBot - aviso", f"Item {item}: os valores realmente batem? \n(Sistema={sistema}, Armário={armario})", prioridade="high", tags="warning")
                log("valores já batem: seguindo sem confirmação manual (manutenção desativada)")

            # 7) dupla checagem antes de confirmar #analisando...

            # --- MANUTENÇÃO DESATIVADA ---
            # registrar_erro(aba, f"o bot vai checar os valores novamente. acompanhe!")
            # janela.showwarning("PharmaBot", f"Item {item}: o bot vai checar os valores novamente. \n(Sistema={sistema}, Armário={armario})")

            sistema = int(campo_sistema.input_value())
            armario = int(campo_armario.input_value())
            # notificacao("PharmaBot", f"dados extraídos: Sistema={sistema}", "short")
            # notificacao("PharmaBot", f"dados extraídos: Armário={armario}", "short")

            ESTADO.update({"sistema_final": sistema, "armario_final": armario})

            if sistema != armario:
                registrar_erro(aba, f"o requisito do Sistema não bateu com o Armário. SISTEMA: {sistema} | ARMARIO: {armario} ")
                raise ValueError(f"Não bateu após ajuste: sistema={sistema}, armário={armario}")

            log("dupla checagem OK, confirmando...", "CONFIRMACAO")

            # 8) confirma
            #TODO: vou separar essas confirmações.  ### parei aqui.
            
            aba.locator("button", has_text="confirmar").click()
            aba.get_by_role("button", name="SIM").click()
            
            log("botões confirmar + SIM clicados, aguardando modal fechar...", "CONFIRMACAO")
            expect(modal).to_be_hidden(timeout=15000)  # substitui o sleep entre itens

            # 9) aguarda a tabela se reorganizar e estar pronta para o próximo item
            aba.wait_for_timeout(5000)  # delay mínimo pro servidor processar #TODO isso é novo. vale revisar na prática
            log("aguardando tabela se reorganizar...", "LISTA")
            expect(aba.locator("table#dt_table tbody tr").first).to_be_visible(timeout=10000)#TODO também é novo.
            log("tabela pronta para o próximo item...", "LISTA")

            conferidos += 1
            log(f"item {item} confirmado em {time.perf_counter() - t_item:.1f}s", "CONFIRMACAO")

        except Exception as e:
            concluiu = False
            registrar_erro(aba, f"Item {item} de {total_remedios}", e)
            notificacao("PharmaBot", "Conferência pausada. Verifique o item atual.", "short")
            log(f"parou no item {item}: {type(e).__name__}", "ERRO")
            # MANUTENÇÃO DESATIVADA: aba.pause() foi removido para deixar o bot seguir no modo de produção.
            break

    duracao = time.perf_counter() - inicio
    log(f"fim: {conferidos}/{total_remedios} conferidos em {duracao / 60:.1f} min", "FIM")

    if concluiu:
        notificacao("PharmaBot", "Conferência concluída!", "short")
        enviar_ntfy(
            "PharmaBot - concluido",
            f"{conferidos}/{total_remedios} itens conferidos em {duracao / 60:.2f} min.",
            prioridade="low",
            tags="white_check_mark",
        )


try:
    with sync_playwright() as p:
        resultado = abrir_navegador(p)
        if resultado is not None:
            aba, total_remedios = resultado
            conferir_remedios(aba, total_remedios)
        else:
            log("não foi possível iniciar a conferência porque abrir_navegador retornou None.", "ERRO")
except Exception as e:
    # erro fora do loop (ex.: Chrome não abriu): avisa o ntfy mesmo sem aba
    traceback.print_exc()
    enviar_ntfy(
        "PharmaBot - ERRO FATAL",
        f"{type(e).__name__}: {e}\n\nÚltimas etapas:\n" + "\n".join(ULTIMAS_ETAPAS) + f"\n\n{traceback.format_exc()}",
        prioridade="urgent",
        tags="rotating_light",
    )
